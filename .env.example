# Required for live screenshot vision extraction & web_search verification
OPENAI_API_KEY=

# Vision-capable model for screenshot text & claim extraction
OPENAI_VISION_MODEL=gpt-5.4-mini

# Web-search compatible model for OpenAI Responses API web_search tool
OPENAI_SEARCH_MODEL=gpt-5.4-mini

# Optional: Google Fact Check Tools API key (if omitted, web_search still runs)
FACTCHECK_API_KEY=

# Public API Protection & Multi-Instance Safeguards
ANALYZE_PUBLIC_ACCESS_ENABLED=true
# Optional shared passcode for public demo access (leave blank for open hackathon demo)
ANALYZE_ACCESS_TOKEN=
ANALYZE_RATE_LIMIT_MAX=12
ANALYZE_RATE_LIMIT_WINDOW_MS=60000
ANALYZE_GLOBAL_HOURLY_LIMIT=60
ANALYZE_MAX_CONCURRENT=4
ANALYZE_PIPELINE_DEADLINE_MS=48000

# Proxy header trust mode: none | vercel | cloudflare | forwarded-rightmost
# (auto-selects vercel when VERCEL=1 if left unset)
TRUSTED_PROXY_MODE=none

# Optional Upstash Redis REST credentials for multi-instance serverless rate limits
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
