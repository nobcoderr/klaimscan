# Required for live screenshot vision extraction & web_search verification
OPENAI_API_KEY=

# Vision-capable model for screenshot text & claim extraction
OPENAI_VISION_MODEL=gpt-5.4-mini

# Web-search compatible model for OpenAI Responses API web_search tool
OPENAI_SEARCH_MODEL=gpt-5.4-mini

# Optional: Google Fact Check Tools API key (if omitted, web_search still runs)
FACTCHECK_API_KEY=
